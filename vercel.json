{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.brightsite.app" }],
      "destination": "https://brightsite.app/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/ourwork",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/ourwork",
      "permanent": true
    }
  ]
}
